soong_namespace {
    imports: [
        "hardware/oplus",
        "vendor/oneplus/astonc",
    ],
}

// OPlus camera consumes these models under their stock .bin filenames.
install_symlink {
    name: "sr_models.bin_symlink",
    device_specific: true,
    installed_location: "lib64/sr_models.bin",
    symlink_target: "sr_models.so",
}

install_symlink {
    name: "sr_ref_models.bin_symlink",
    device_specific: true,
    installed_location: "lib64/sr_ref_models.bin",
    symlink_target: "sr_ref_models.so",
}
